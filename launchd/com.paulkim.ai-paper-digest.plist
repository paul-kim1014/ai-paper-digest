<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.paulkim.ai-paper-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/paul.kim/ai-paper-digest/weekly_update.sh</string>
    </array>

    <!-- 매주 월요일(요일 1) 오전 9시. 그 시각에 잠들어 있으면 깨어난 직후 실행됨. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/paul.kim/ai-paper-digest/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/paul.kim/ai-paper-digest/data/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
