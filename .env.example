# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 git에 올라가지 않음)

# ── 요약 엔진 (backend="claude" 또는 "auto" 일 때만 필요) ──
ANTHROPIC_API_KEY=sk-ant-여기에_키

# ── Slack 주간 알림 (둘 중 하나만 설정하면 됨) ──
# 방식 1) 봇 토큰: 본인에게 DM (config.json의 notify.slack.recipient_email 로 조회)
#   Slack 앱 생성 → OAuth 스코프 chat:write, users:read.email → 워크스페이스 설치 → Bot User OAuth Token(xoxb-)
SLACK_BOT_TOKEN=xoxb-여기에_봇토큰

# 방식 2) 웹훅: 지정한 채널에 게시 (DM 아님)
#   Slack 앱 → Incoming Webhooks 활성화 → Add New Webhook → 채널 선택 → URL 복사
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
