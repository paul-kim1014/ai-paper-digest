{
  "display_information": {
    "name": "AI Paper Digest",
    "description": "매주 AI 논문 요약 다이제스트 링크를 DM으로 보내주는 봇",
    "background_color": "#5b4bff"
  },
  "features": {
    "bot_user": {
      "display_name": "AI Paper Digest",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
